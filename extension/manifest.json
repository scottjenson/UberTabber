{
  "manifest_version": 3,
  "name": "UberTabber",
  "version": "0.4.0",
  "description": "Reports tab focus events to the UberTabber Mac app.",
  "permissions": ["tabs", "alarms", "scripting", "storage", "identity", "identity.email"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  }
}
